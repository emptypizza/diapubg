{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diapubg",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-04-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "GameWorld" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameWorld"] }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    },
    "traces": { "enabled": false }
  }
}
